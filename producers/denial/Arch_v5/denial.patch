+pub(crate) fn dispatch_consumer_keyboard_text(
+    state: &mut RuntimeState,
+    target: &super::text_input::ConsumerTextTarget,
+    text: &str,
+) -> bool {
+    use smithay::input::keyboard::KeymapFile;
+    use smithay::reexports::wayland_server::protocol::{wl_keyboard, wl_keyboard::KeymapFormat};
+    use smithay::wayland::seat::WaylandFocus;
+    use std::os::fd::AsFd;
+    let Some(frontend) = state.wayland.as_ref() else {
+        return false;
+    };
+    if state.secure_session_locked()
+        || !super::injected_text::valid_legacy_commit(text)
+        || frontend.consumer_text_target().as_ref() != Some(target)
+    {
+        return false;
+    }
+    let Some(keyboard) = frontend.seat.get_keyboard() else {
+        return false;
+    };
+    let Some(surface) = keyboard
+        .current_focus()
+        .and_then(|focus| focus.wl_surface().map(|s| s.into_owned()))
+    else {
+        return false;
+    };
+    let Ok(client) = frontend.display_handle.get_client(surface.id()) else {
+        return false;
+    };
+    let keyboards: Vec<_> = keyboard.client_keyboards(&client).collect();
+    if keyboards.is_empty() {
+        return false;
+    }
+    let time = frontend.start_time.elapsed().as_millis() as u32;
+    let mods = keyboard.modifier_state().serialized;
+    let original = keyboard.with_xkb_state(state, |context| {
+        let xkb = context.xkb().lock().unwrap();
+        // SAFETY: borrowed keymap only used under the XKB mutex, no reference escapes.
+        KeymapFile::new(unsafe { xkb.keymap() })
+    });
+    let context = xkb::Context::new(xkb::CONTEXT_NO_FLAGS);
+    let chars: Vec<_> = text.chars().collect();
+    // Compile and prepare ALL files before sending anything: bad input/keymap
+    // cannot leave a partial prefix or the client's keymap replaced.
+    let mut chunks = Vec::new();
+    for chunk in chars.chunks(super::injected_text::LEGACY_KEYMAP_CHARS) {
+        let source = super::injected_text::legacy_keymap(chunk);
+        let Some(map) = xkb::Keymap::new_from_string(
+            &context,
+            source,
+            xkb::KEYMAP_FORMAT_TEXT_V1,
+            xkb::KEYMAP_COMPILE_NO_FLAGS,
+        ) else {
+            warn!("consumer Unicode keymap compilation failed");
+            return false;
+        };
+        chunks.push((KeymapFile::new(&map), chunk.len()));
+    }
+    // with_fd(false) creates a fresh writable tempfile for old protocol clients.
+    // Retain duplicated prepared fds before ANY events, including restoration;
+    // a second with_fd() is not guaranteed to succeed under fd/disk pressure.
+    let prepare = |file: &KeymapFile| -> std::io::Result<_> {
+        let mut prepared = None;
+        file.with_fd(false, |fd, size| {
+            prepared = Some(fd.try_clone_to_owned().map(|owned| (owned, size)));
+        })?;
+        prepared.expect("with_fd did not invoke its callback")
+    };
+    let Ok((original_fd, original_size)) = prepare(&original) else {
+        warn!("consumer original keymap file preparation failed");
+        return false;
+    };
+    let mut prepared = Vec::new();
+    for (file, count) in &chunks {
+        let Ok((fd, size)) = prepare(file) else {
+            warn!("consumer Unicode keymap file preparation failed");
+            return false;
+        };
+        prepared.push((fd, size, *count));
+    }
+    // No fallible preparation, event-loop dispatch or physical XKB mutation
+    // occurs after this point. Ordered events restore the same client's map
+    // and its exact modifiers, without touching clipboard or other clients.
