@@ -0,0 +1,36 @@
+//! Bounds and client-only keymap policy for externally injected native text.
+pub const MAX_COMMIT_BYTES: usize = 4000;
+pub fn valid_commit(text: &str) -> bool {
+    !text.is_empty() && text.len() <= MAX_COMMIT_BYTES && !text.contains('\0')
+}
+
+/// A bounded client-only map transaction, never a physical-seat keymap.
+pub const LEGACY_KEYMAP_CHARS: usize = 247;
+pub fn valid_legacy_commit(text: &str) -> bool {
+    valid_commit(text)
+        && text
+            .chars()
+            .all(|c| !c.is_control() || matches!(c, '\n' | '\r' | '\t' | '\u{8}'))
+}
+pub fn legacy_keymap(chars: &[char]) -> String {
+    assert!(!chars.is_empty() && chars.len() <= LEGACY_KEYMAP_CHARS);
+    let mut map = String::from("xkb_keymap { xkb_keycodes { minimum = 9; maximum = 255; ");
+    for index in 0..chars.len() {
+        map.push_str(&format!("<K{index:03}> = {}; ", index + 9));
+    }
+    map.push_str("}; xkb_types { type \"ONE_LEVEL\" { modifiers = None; map[None] = Level1; }; }; xkb_compatibility {}; xkb_symbols { ");
+    for (index, character) in chars.iter().enumerate() {
+        let symbol = match character {
+            '\n' | '\r' => 0xff0d,
+            '\t' => 0xff09,
+            '\u{8}' => 0xff08,
+            c if u32::from(*c) <= 0xff => u32::from(*c),
+            c => 0x01000000 | u32::from(*c),
+        };
+        map.push_str(&format!(
+            "key <K{index:03}> {{ type=\"ONE_LEVEL\", [ 0x{symbol:x} ] }}; "
+        ));
+    }
+    map.push_str("}; };");
+    map
+}
