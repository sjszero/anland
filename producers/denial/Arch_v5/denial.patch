+    pub(crate) fn synchronize_scene_recovery(
+        &mut self,
+        metadata: u64,
+        ready: bool,
+    ) -> Result<(), Box<dyn Error>> {
+        let lock_epoch = self.authentication.locked_epoch();
+        self.synchronize_lock_frame()?;
+        let Some(gate) = self.scene_recovery.as_mut() else {
+            return Ok(());
+        };
+        if gate.finished() {
+            return Ok(());
+        }
+        // Ordinary pending updates after the ordered snapshot do not revoke it.
+        // Lock changes always revoke, even when the scene has not settled yet.
+        if !ready {
+            gate.invalidate_lock_epoch(lock_epoch);
+            return Ok(());
+        }
+        let version = scene_recovery::SceneVersion {
+            metadata,
+            lock_epoch,
+        };
+        if let Some(packet) = gate.request(version) {
+            info!(
+                generation = self.generation,
+                metadata,
+                ?lock_epoch,
+                "external recovery scene barrier published"
+            );
