+fn main() {
+    println!("cargo:rerun-if-env-changed=ANLAND_DENIAL_LIB_DIR");
+    if std::env::var_os("CARGO_FEATURE_ANLAND").is_none() {
+        return;
+    }
+    let path = std::env::var_os("ANLAND_DENIAL_LIB_DIR")
+        .expect("anland requires ANLAND_DENIAL_LIB_DIR from the staged bridge/public build");
+    let path = std::path::PathBuf::from(path)
+        .canonicalize()
+        .expect("ANLAND_DENIAL_LIB_DIR does not exist");
+    for name in ["libanland_denial_bridge.so", "libdisplay_producer.so"] {
+        assert!(
+            path.join(name).is_file(),
+            "missing staged Anland library: {name}"
+        );
+        println!("cargo:rerun-if-changed={}", path.join(name).display());
+    }
+    println!("cargo:rustc-link-search=native={}", path.display());
+    // The executable and both libraries share the private installed directory.
+    // Do not embed the staging directory into a distributable executable.
+    println!("cargo:rustc-link-arg-bin=deniald=-Wl,-rpath,$ORIGIN");
+}
