diff --git a/plugins/denial_desktop/lib/src/core/scene_recovery_binding.dart b/plugins/denial_desktop/lib/src/core/scene_recovery_binding.dart
new file mode 100644
--- /dev/null
+++ b/plugins/denial_desktop/lib/src/core/scene_recovery_binding.dart
@@ -0,0 +1,55 @@
+import 'dart:async';
+
+import 'package:flutter/services.dart';
+import 'package:flutter/widgets.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:denial_flutter_sdk/state.dart';
+
+final sceneRecoveryRequestProvider =
+    NotifierProvider<SceneRecoveryRequest, String>(SceneRecoveryRequest.new);
+
+/// Native sends this marker AFTER texture registration, window/workspace/focus
+/// replay. Input publishers watch it so even an unchanged empty layout rebuilds.
+class SceneRecoveryRequest extends Notifier<String> {
+  static const _channel = BasicMessageChannel<String>(
+    'denial/scene_recovery',
+    StringCodec(),
+  );
+  int _lifecycle = 0;
+  @override
+  String build() {
+    final lifecycle = ++_lifecycle;
+    final subscription = ref
+        .watch(denialBridgeProvider)
+        .sceneRecoveryRequests
+        .listen((packet) {
+          state = packet;
+          _settle(packet, lifecycle, 2);
+        });
+    ref.onDispose(() {
+      ++_lifecycle;
+      unawaited(subscription.cancel());
+    });
+    return '';
+  }
+
+  void _settle(String packet, int lifecycle, int frames) {
+    WidgetsBinding.instance.addPostFrameCallback((_) {
+      if (_lifecycle != lifecycle || state != packet) return;
+      if (frames > 1) {
+        _settle(packet, lifecycle, frames - 1);
+        return;
+      }
+      // Frame-batched focus and layout callbacks from the first frame have now
+      // been reduced. Native still requires a separately authorized raster frame.
+      unawaited(
+        _channel.send(packet).then((_) {
+          if (_lifecycle == lifecycle && state == packet) {
+            WidgetsBinding.instance.scheduleFrame();
+          }
+        }),
+      );
+    });
+    WidgetsBinding.instance.scheduleFrame();
+  }
+}
