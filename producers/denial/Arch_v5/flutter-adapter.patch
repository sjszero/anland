+    /// Posts an owned operation behind previously queued raster work. Neither
+    /// callback nor completion channel borrows the caller's stack. The caller
+    /// polls without blocking; dropping the receiver is NOT task cancellation.
+    pub fn post_render_operation(
+        &self,
+        operation: impl FnOnce() -> RenderOperationResult + Send + 'static,
+    ) -> Result<std::sync::mpsc::Receiver<RenderOperationResult>, Box<dyn Error>> {
+        if thread::current().id()
+            != self
+                .state
+                .as_ref()
+                .ok_or("engine is shut down")?
+                ._callback_state
+                .platform_thread
+        {
+            return Err("render operation must originate on the platform thread".into());
+        }
+        let (sender, receiver) = std::sync::mpsc::sync_channel(1);
+        let task = Box::new(RenderOperation {
+            operation: Box::new(operation),
+            completed: sender,
+        });
+        let data = Box::into_raw(task).cast::<c_void>();
+        let state = self.state.as_ref().ok_or("engine is shut down")?;
+        // SAFETY: the task owns everything reachable from data until the
+        // render callback consumes it. On posting failure no callback is queued.
+        let result = unsafe {
+            (state._callback_state.post_render_thread_task)(
+                self.engine().raw_handle(),
+                Some(run_render_operation),
+                data,
+            )
+        };
+        if result != sys::FlutterEngineResult_kSuccess {
+            // SAFETY: failed posting retained no ownership of data.
+            unsafe { drop(Box::from_raw(data.cast::<RenderOperation>())) };
+            return Err(EngineError::Call {
+                operation: "PostRenderOperation",
+                result,
+            }
+            .into());
+        }
+        Ok(receiver)
+    }
