+    Skip,
+    Render { flutter_output: Option<OutputId> },
+}
+
+/// Successful dispatch is not the same as forwarding a Flutter VSync baton.
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub(crate) struct RenderDispatch {
+    pub authorized: bool,
+    pub vsync_dispatched: bool,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(super) struct OutputFrameRequest {
+    pub(super) tick: FrameTick,
+    pub(super) dirty_serial: u64,
+    pub(super) lock_frame_token: u64,
+    pub(super) fingerprint_epoch: u64,
+    pub(super) scene_recovery_token: u64,
+}
