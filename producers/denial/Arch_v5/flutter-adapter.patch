@@ -0,0 +1,69 @@
+//! Native target selection policy; no transport state or FD ownership.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum PoolSelection {
+    Automatic {
+        initial_scanout: usize,
+    },
+    External {
+        generation: u64,
+        selected: Option<usize>,
+    },
+}
+
+impl PoolSelection {
+    pub fn valid(self, count: usize) -> bool {
+        match self {
+            Self::Automatic { initial_scanout } => count >= 3 && initial_scanout < count,
+            Self::External {
+                generation,
+                selected,
+            } => generation != 0 && count > 0 && selected.is_none(),
+        }
+    }
+
+    pub fn initially_held(self, index: usize) -> bool {
+        matches!(self, Self::Automatic { initial_scanout } if initial_scanout == index)
+    }
+
+    pub fn external(self) -> bool {
+        matches!(self, Self::External { .. })
+    }
+
+    pub fn select(
+        &mut self,
+        generation: u64,
+        index: usize,
+        count: usize,
+        actual_count: usize,
+    ) -> bool {
+        match self {
+            Self::External {
+                generation: expected,
+                selected,
+            } if *expected == generation
+                && count == actual_count
+                && index < count
+                && selected.is_none() =>
+            {
+                *selected = Some(index);
+                true
+            }
+            _ => false,
+        }
+    }
+
+    pub fn available(self, count: usize, mut free: impl FnMut(usize) -> bool) -> Option<usize> {
+        match self {
+            Self::Automatic { .. } => (0..count).find(|&index| free(index)),
+            Self::External { selected, .. } => {
+                selected.filter(|&index| index < count && free(index))
+            }
+        }
+    }
+
+    pub fn revoke(&mut self) {
+        if let Self::External { selected, .. } = self {
+            *selected = None;
+        }
+    }
+}
