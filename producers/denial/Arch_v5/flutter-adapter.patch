+                width: size.width as usize,
+                height: size.height as usize,
+                device_pixel_ratio: self.device_pixel_ratio,
+            }],
+        )?;
+        self.frame_interval = Duration::from_nanos(1_000_000_000_000 / u64::from(refresh));
