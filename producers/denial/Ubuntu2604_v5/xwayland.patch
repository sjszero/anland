@@ -123,6 +123,15 @@
 {
     if (!xwl_glamor_has_wl_drm(xwl_screen) &&
         xwl_screen->dmabuf_protocol_version < 4) {
+        /* A kgsl/turnip compositor can expose linux-dmabuf v3 without wl_drm
+         * and without v4 feedback. Buffers still travel over dmabuf, and the
+         * GBM device is chosen by xwl_glamor_gbm_init_main_dev()'s fallback,
+         * so glamor remains usable. */
+        if (xwl_screen->dmabuf_protocol_version >= 3) {
+            LogMessageVerb(X_INFO, 3,
+                           "glamor: using linux-dmabuf v3 without wl_drm\n");
+            return TRUE;
+        }
         LogMessageVerb(X_INFO, 3, "glamor: 'wl_drm' not supported and linux-dmabuf v4 not supported\n");
         return FALSE;
     }
