         struct zwp_linux_buffer_params_v1 *params;
 
         params = zwp_linux_dmabuf_v1_create_params(xwl_screen->dmabuf);
@@ -773,6 +781,14 @@
         strides[0] < width * bpp / 8)
        goto error;
 
+    /* Some freedreno/kgsl Mesa builds rewrite a linear modifier (0) to the
+     * bogus value 1274 (0x4fa) while creating a DRI3 pixmap. 1274 is not a
+     * valid DRM modifier, so gbm_bo_import() rejects the buffer and the
+     * client fails its allocation. The buffer really is linear; map the
+     * known-bogus value back before importing. */
+    if (modifier == 1274ULL)
+        modifier = DRM_FORMAT_MOD_LINEAR;
+
