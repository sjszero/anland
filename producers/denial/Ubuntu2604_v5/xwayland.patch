+     * so without this the pixmap never gets a wl_buffer and the X11 window
+     * stays black. linux-dmabuf defines INVALID as "compositor infers the
+     * layout", so submit it through the dmabuf path. */
     if (xwl_screen->dmabuf &&
-        xwl_glamor_is_modifier_supported(xwl_screen, format, modifier)) {
+        (modifier == DRM_FORMAT_MOD_INVALID ||
