prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@/display-producer

Name: display-producer
Description: Unified Anland producer transport, device and presentation API
Version: 5.0.0
Libs: -L${libdir} -ldisplay_producer
Libs.private: -lpthread
Cflags: -I${includedir}
